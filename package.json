{
  "name": "adsblol-ts",
  "version": "0.0.0",
  "description": "Unofficial, zero-runtime-dependency TypeScript client for the adsb.lol API",
  "license": "MIT",
  "packageManager": "pnpm@10.18.2",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "gen": "openapi-typescript spec/openapi.json -o src/generated/schema.d.ts",
    "spec:update": "tsx scripts/update-spec.ts && pnpm gen",
    "spec:check": "tsx scripts/check-spec-drift.ts",
    "smoke": "tsx scripts/live-smoke.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "msw": "^3.0.3",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
